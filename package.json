{
  "name": "dropfetch",
  "version": "1.0.0",
  "private": true,
  "description": "Monitors Telegram channels and auto-downloads files matching filename keywords before auto-delete removes them.",
  "license": "MIT",
  "author": "iGattreX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iGattreX/DropFetch.git"
  },
  "homepage": "https://github.com/iGattreX/DropFetch#readme",
  "bugs": {
    "url": "https://github.com/iGattreX/DropFetch/issues"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "login": "tsx src/login.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.2.0",
    "big-integer": "^1.6.52",
    "dotenv": "^16.4.5",
    "fastify": "^5.4.0",
    "mime-types": "^2.1.35",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
